---
// Modal da Biblioteca de Exercícios (Lista, Mapa 2D & Holograma 3D) — StrongLog Pro
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
---

<div id="exercise-library-modal" class="fixed inset-0 z-[300] bg-black/95 backdrop-blur-xl hidden">
    <div onclick="event.stopPropagation()" class="absolute bottom-0 left-0 right-0 glass h-full sm:h-[92vh] sm:h-[92dvh] rounded-none sm:rounded-t-[45px] p-4 sm:p-8 space-y-3 sm:space-y-5 flex flex-col shadow-2xl border-white/10">
        <div class="flex justify-between items-center text-white shrink-0">
            <div>
                <h2 class="text-3xl font-black italic tracking-tighter uppercase leading-none">Biblioteca</h2>
                <span id="library-count-badge" class="text-[9px] font-mono text-[#00FF9D] uppercase tracking-widest">1.324 Exercícios</span>
            </div>
            <IconButton icon="x" size="md" onclick="app.closeModal('exercise-library-modal')" title="Fechar Biblioteca" />
        </div>

        <!-- View Mode Switcher: Lista vs Mapa 2D vs 3D Hologram -->
        <div id="lib-view-mode-switcher" class="flex bg-white/5 p-1 rounded-2xl gap-1 shrink-0">
            <button id="lib-view-list-btn" onclick="app.setLibraryViewMode('list')" class="flex-1 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider bg-[#00FF9D]/15 text-[#00FF9D] transition-all flex items-center justify-center gap-1.5"><i data-lucide="list" class="w-3.5 h-3.5"></i> Lista</button>
            <button id="lib-view-map-btn" onclick="app.setLibraryViewMode('map')" class="flex-1 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider text-gray-400 hover:text-white transition-all flex items-center justify-center gap-1.5"><i data-lucide="activity" class="w-3.5 h-3.5"></i> Mapa 2D</button>
            <button id="lib-view-3d-btn" onclick="app.setLibraryViewMode('3d')" class="flex-1 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-wider text-gray-400 hover:text-white transition-all flex items-center justify-center gap-1.5"><i data-lucide="box" class="w-3.5 h-3.5"></i> Hologram 3D</button>
        </div>

        <!-- Collapsible 2D/3D Visualizer Toggle Bar -->
        <div id="library-visualizer-toggle-bar" class="hidden flex items-center justify-between px-1 shrink-0">
            <button id="library-visualizer-toggle" onclick="app.toggleLibraryVisualizer()" aria-expanded="true" aria-controls="library-visualizer-section" class="w-full py-1.5 px-3 glass text-[9px] font-black uppercase tracking-wider text-gray-400 hover:text-[#00FF9D] active:scale-98 transition-all flex items-center justify-center gap-1.5 rounded-xl border-white/5">
                <i id="library-visualizer-toggle-icon" data-lucide="chevron-up" class="w-3.5 h-3.5 text-[#00FF9D]"></i>
                <span id="library-visualizer-toggle-text">Recolher Visualizador (Focar Lista)</span>
            </button>
        </div>

        <!-- Collapsible 2D/3D Visualizer Section -->
        <div id="library-visualizer-section" aria-hidden="false" class="library-visualizer-wrapper shrink-0">
            <!-- 2D Interactive Anatomical Map Container -->
            <div id="library-map-container" class="hidden flex-col items-center justify-center space-y-2 py-1" onclick="event.stopPropagation()">
                <div class="flex justify-between items-center w-full px-2">
                    <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">Toque em um músculo para filtrar:</span>
                    <div class="flex items-center gap-1.5">
                        <!-- Toggle Frontal ↔ Dorsal 2D -->
                        <button id="svg-view-front-btn" onclick="app.switchSvgView('anterior')" class="px-3 py-2 min-h-[44px] min-w-[44px] rounded-xl text-[9px] font-black uppercase bg-[#00FF9D]/15 text-[#00FF9D] flex items-center justify-center transition-all">Frente</button>
                        <button id="svg-view-back-btn" onclick="app.switchSvgView('posterior')" class="px-3 py-2 min-h-[44px] min-w-[44px] rounded-xl text-[9px] font-black uppercase text-gray-400 hover:text-white flex items-center justify-center transition-all">Costas</button>
                        <!-- Controles de Zoom 2D -->
                        <button onclick="app.zoomSvg(0.25)" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-gray-400 hover:text-[#00FF9D] active:scale-95 flex items-center justify-center transition-all" aria-label="Aumentar zoom" title="Aumentar Zoom"><i data-lucide="zoom-in" class="w-4 h-4"></i></button>
                        <button onclick="app.zoomSvg(-0.25)" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-gray-400 hover:text-[#00FF9D] active:scale-95 flex items-center justify-center transition-all" aria-label="Diminuir zoom" title="Diminuir Zoom"><i data-lucide="zoom-out" class="w-4 h-4"></i></button>
                        <button onclick="app.resetSvgZoom()" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-gray-400 hover:text-white active:scale-95 flex items-center justify-center transition-all" aria-label="Resetar visão" title="Resetar Zoom"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></button>
                    </div>
                </div>
                <div id="library-svg-stage" class="w-full h-44 sm:h-48 flex items-center justify-center relative overflow-hidden"></div>
                <!-- Chips Anatômicos Rápidos (Acessibilidade Dual RF02-v5.4) -->
                <div id="library-muscle-chips-bar" class="w-full flex items-center gap-1.5 overflow-x-auto custom-scrollbar py-1.5 px-1 shrink-0 border-t border-white/5" role="toolbar" aria-label="Atalhos rápidos para grupos musculares"></div>
            </div>

            <!-- 3D Hologram Interactive Stage Container -->
            <div id="library-3d-container" class="hidden flex-col items-center justify-center space-y-2 py-1" onclick="event.stopPropagation()">
                <div class="flex justify-between items-center w-full px-2">
                    <span class="text-[9px] font-black uppercase tracking-widest text-gray-400">Holograma 3D Interativo:</span>
                    <div class="flex items-center gap-1.5">
                        <!-- Toggle Frontal ↔ Dorsal 3D -->
                        <button id="3d-view-front-btn" onclick="app.rotate3DToView('anterior')" class="px-3 py-2 min-h-[44px] min-w-[44px] rounded-xl text-[9px] font-black uppercase bg-[#00FF9D]/15 text-[#00FF9D] flex items-center justify-center transition-all">Frente</button>
                        <button id="3d-view-back-btn" onclick="app.rotate3DToView('posterior')" class="px-3 py-2 min-h-[44px] min-w-[44px] rounded-xl text-[9px] font-black uppercase text-gray-400 hover:text-white flex items-center justify-center transition-all">Costas</button>
                        <!-- Controles de Zoom 3D -->
                        <button onclick="app.zoom3D(-0.4)" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-gray-400 hover:text-[#00FF9D] active:scale-95 flex items-center justify-center transition-all" aria-label="Aumentar zoom" title="Aumentar Zoom"><i data-lucide="zoom-in" class="w-4 h-4"></i></button>
                        <button onclick="app.zoom3D(0.4)" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-gray-400 hover:text-[#00FF9D] active:scale-95 flex items-center justify-center transition-all" aria-label="Diminuir zoom" title="Diminuir Zoom"><i data-lucide="zoom-out" class="w-4 h-4"></i></button>
                        <button onclick="app.reset3DCamera()" class="p-2.5 min-h-[44px] min-w-[44px] glass rounded-xl text-[9px] font-mono uppercase text-gray-400 hover:text-white active:scale-95 flex items-center justify-center transition-all" aria-label="Resetar visão" title="Resetar Câmera"><i data-lucide="rotate-ccw" class="w-4 h-4"></i></button>
                    </div>
                </div>
                <div class="hologram-stage h-48 sm:h-56 w-full flex items-center justify-center relative">
                    <div id="library-3d-hud" class="absolute top-2 left-2 right-2 z-10 pointer-events-none"></div>
                    <div class="hologram-grid"></div>
                    <canvas id="library-3d-canvas" class="w-full h-full cursor-grab active:cursor-grabbing"></canvas>
                    <div class="absolute bottom-2 left-3 text-[8px] font-mono text-[#00FF9D]/70 uppercase tracking-widest pointer-events-none">● Gire 360° com o dedo · Zoom por pinça/scroll</div>
                </div>
            </div>
        </div>

        <!-- Active Muscle Filter Chip -->
        <div id="library-active-muscle-filter" class="hidden glass p-3 px-4 rounded-2xl flex justify-between items-center border-[#00FF9D]/30 bg-[#00FF9D]/5 animate-fade shrink-0">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#00FF9D] animate-pulse"></span>
                <span class="text-xs font-black uppercase text-white" id="library-filter-muscle-label">Peitoral</span>
            </div>
            <button onclick="app.clearMuscleFilter()" class="text-[9px] font-black uppercase tracking-wider text-red-400 hover:text-red-300 active:text-red-200">Remover Filtro [X]</button>
        </div>

        <!-- Search and Controls -->
        <div class="flex gap-2 shrink-0">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600"></i>
                <input id="search-exercise" type="text" onfocus="app.onSearchExerciseFocus()" onblur="app.onSearchExerciseBlur()" oninput="app.onSearchExerciseFocus(); app.debouncedFilterExerciseLibrary()" class="w-full bg-white/5 p-4 pl-14 rounded-2xl focus:outline-none font-bold text-sm text-white" placeholder="Buscar exercício ou músculo..." />
            </div>
            <IconButton icon="plus" size="md" class="p-4" onclick="app.showCustomExerciseForm()" title="Cadastrar Exercício" variant="accent" />
        </div>
        
        <div class="grid grid-cols-2 gap-2 shrink-0">
            <select id="filter-body-part" onchange="app.onBodyPartDropdownChange()" class="bg-[#111] border border-white/5 p-3.5 rounded-xl focus:outline-none text-xs font-bold text-gray-300 appearance-none">
                <option value="" class="bg-[#0a0a0a] text-white">Todos os Músculos</option>
                <option value="Braços" class="bg-[#0a0a0a] text-white">Braços</option>
                <option value="Antebraços" class="bg-[#0a0a0a] text-white">Antebraços</option>
                <option value="Costas" class="bg-[#0a0a0a] text-white">Costas</option>
                <option value="Peito" class="bg-[#0a0a0a] text-white">Peito</option>
                <option value="Ombros" class="bg-[#0a0a0a] text-white">Ombros</option>
                <option value="Pernas" class="bg-[#0a0a0a] text-white">Pernas</option>
                <option value="Panturrilhas" class="bg-[#0a0a0a] text-white">Panturrilhas</option>
                <option value="Cintura" class="bg-[#0a0a0a] text-white">Cintura/Abdômen</option>
                <option value="Cardio" class="bg-[#0a0a0a] text-white">Cardio</option>
                <option value="Pescoço" class="bg-[#0a0a0a] text-white">Pescoço</option>
            </select>
            <select id="filter-equipment" onchange="app.filterExerciseLibrary()" class="bg-[#111] border border-white/5 p-3.5 rounded-xl focus:outline-none text-xs font-bold text-gray-300 appearance-none">
                <option value="" class="bg-[#0a0a0a] text-white">Equipamentos (Todos)</option>
                <option value="Peso Corporal" class="bg-[#0a0a0a] text-white">Peso Corporal</option>
                <option value="Halter" class="bg-[#0a0a0a] text-white">Halter</option>
                <option value="Barra" class="bg-[#0a0a0a] text-white">Barra</option>
                <option value="Cabo" class="bg-[#0a0a0a] text-white">Cabo/Polia</option>
                <option value="Máquina" class="bg-[#0a0a0a] text-white">Máquina</option>
                <option value="Elástico" class="bg-[#0a0a0a] text-white">Elástico</option>
                <option value="Smith" class="bg-[#0a0a0a] text-white">Smith</option>
                <option value="Kettlebell" class="bg-[#0a0a0a] text-white">Kettlebell</option>
                <option value="Barra W" class="bg-[#0a0a0a] text-white">Barra W</option>
            </select>
        </div>
        
        <div id="library-list" class="flex-1 overflow-y-auto space-y-2 custom-scrollbar pr-1 pb-4"></div>

        <!-- Fixed Bottom Action Bar for Multi-Add -->
        <div id="library-bottom-bar" class="p-3 bg-[#0a0a0c]/95 backdrop-blur-xl border border-white/10 rounded-2xl shrink-0 mt-auto flex items-center justify-between gap-3 shadow-2xl z-20">
            <div class="flex flex-col min-w-0">
                <span id="library-bottom-status" class="text-[9px] font-black uppercase tracking-widest text-[#00FF9D] flex items-center gap-1.5 truncate">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00FF9D] animate-pulse"></span>
                    Adição Contínua
                </span>
                <span id="library-bottom-counter" class="text-xs font-black text-white italic tracking-tight truncate">0 exercícios no treino</span>
            </div>
            <Button variant="primary" size="md" class="px-5 py-3 rounded-xl flex items-center gap-2 shadow-[0_0_20px_rgba(0,255,157,0.3)] shrink-0" onclick="app.closeModal('exercise-library-modal')" icon="check" iconClass="w-4 h-4 text-black">
                <span id="library-bottom-btn-text">Concluir e Voltar</span>
            </Button>
        </div>
    </div>
</div>
