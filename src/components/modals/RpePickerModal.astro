---
// Modal de Seleção de RPE / RIR (Escala de Esforço) — StrongLog Pro
import IconButton from '../ui/IconButton.astro';
---

<div id="rpe-picker-modal" class="fixed inset-0 z-[520] bg-black/90 backdrop-blur-xl hidden text-white">
    <div class="glass w-full max-w-sm p-6 space-y-4 border-white/10 shadow-2xl animate-fade m-auto">
        <div class="flex justify-between items-center border-b border-white/5 pb-2">
            <div>
                <h3 class="text-base font-black italic uppercase tracking-tight text-white">Escala RPE (Esforço)</h3>
                <p class="text-[9px] text-[#00FF9D] font-bold uppercase tracking-wider">RIR = Repetições em Reserva</p>
            </div>
            <IconButton icon="x" size="sm" class="p-2" onclick="app.closeModal('rpe-picker-modal')" />
        </div>
        <div class="space-y-1.5 max-h-[60vh] overflow-y-auto custom-scrollbar pr-1" id="rpe-options-list">
            <!-- Opções de RPE geradas via JS -->
        </div>
    </div>
</div>
