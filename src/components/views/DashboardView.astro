---
// Componente de Tela: Dashboard / Início — StrongLog Pro
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
---

<section id="view-dashboard" class="space-y-6 animate-fade">
    <!-- Quick Start Hero Card -->
    <div class="glass p-5 rounded-3xl flex items-center justify-between border-[#00FF9D]/30 bg-gradient-to-r from-[#00FF9D]/10 via-black/40 to-black/60 shadow-xl shadow-black/40">
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                <span class="p-2 rounded-xl bg-[#00FF9D]/20 text-[#00FF9D]"><i data-lucide="zap" class="w-4 h-4"></i></span>
                <h3 class="text-xs font-black text-white uppercase italic tracking-wide">Treino Rápido Avulso</h3>
            </div>
            <p class="text-[10px] text-gray-400 font-medium">Inicie uma sessão instantânea sem precisar montar rotina.</p>
        </div>
        <Button variant="primary" size="md" class="py-3 px-4 rounded-xl uppercase italic tracking-wider shadow-lg shadow-[#00FF9D]/25 shrink-0" onclick="app.startFreeWorkout()">Treinar Agora</Button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="glass p-6 space-y-4">
            <div class="flex justify-between items-center">
                <h2 class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Volume Semanal</h2>
                <span id="weekly-total" class="text-xs font-black text-[#00FF9D] bg-[#00FF9D]/10 px-3 py-1 rounded-full">-- kg</span>
            </div>
            <div class="h-32 w-full"><canvas id="volumeChart"></canvas></div>
        </div>

        <div class="glass p-6 space-y-4">
            <h2 class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Distribuição por Músculo</h2>
            <div class="h-32 w-full"><canvas id="muscleGroupChart"></canvas></div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="flex justify-between items-center px-1">
            <h2 class="text-lg font-black tracking-tight uppercase italic text-white">Minhas Rotinas</h2>
            <div class="flex gap-2">
                <IconButton icon="trophy" iconClass="w-4 h-4" variant="accent" size="touch44" onclick="app.showRecords()" title="Recordes Pessoais" />
                <Button id="btn-new-plan" data-action="new-plan" data-testid="btn-new-plan" variant="primary" class="text-xs font-black min-h-[44px] px-5 py-2.5 rounded-full uppercase tracking-tighter shadow-md shadow-[#00FF9D]/20 flex items-center justify-center cursor-pointer" onclick="app.showNewPlanForm()" aria-label="Nova Rotina">+ Nova Rotina</Button>
            </div>
        </div>
        <div id="workout-list" class="grid grid-cols-1 gap-3"><div id="plans-list" class="contents"></div></div>
    </div>
</section>
