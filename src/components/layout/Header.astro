---
// Componente de Cabeçalho Superior — StrongLog Pro
import IconButton from '../ui/IconButton.astro';

interface Props {
  titlePrefix?: string;
  titleSuffix?: string;
}

const { titlePrefix = "STRONG", titleSuffix = "LOG" } = Astro.props;
---

<header class="p-5 pb-2 flex justify-between items-center sticky top-0 bg-[#0a0a0a]/95 backdrop-blur-xl z-[100] border-b border-white/5">
    <div>
        <h1 class="text-2xl font-black italic tracking-tighter">{titlePrefix}<span class="text-[#00FF9D]">{titleSuffix}</span></h1>
        <p id="current-date" class="text-[9px] text-gray-500 font-bold uppercase tracking-[0.3em]"></p>
    </div>
    <div class="flex items-center gap-2">
        <IconButton
            icon="help-circle"
            variant="accent"
            size="touch44"
            onclick="app.showHelpModal()"
            title="Central de Ajuda & Guia de Uso"
        />
        <IconButton
            icon="settings-2"
            variant="glass"
            size="touch44"
            onclick="app.toggleSettings()"
            title="Ajustes"
        />
    </div>
</header>
